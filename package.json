{
  "name": "copilot-cost-token-tracker-ollama",
  "displayName": "Copilot Cost & Token Tracker - With Ollama Cloud Support",
  "description": "Track, analyze, and visualize token usage, USD costs, and AI Credits for Ollama Cloud and GitHub Copilot agent sessions in VS Code",
  "version": "1.1.5",
  "publisher": "ronen1malka",
  "author": {
    "name": "Ronen Malka"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ronen1malka/copilot-cost-token-tracker-ollama.git"
  },
  "bugs": {
    "url": "https://github.com/ronen1malka/copilot-cost-token-tracker-ollama/issues"
  },
  "homepage": "https://github.com/ronen1malka/copilot-cost-token-tracker-ollama#readme",
  "keywords": [
    "ollama",
    "ollama-cloud",
    "ollama cloud",
    "ollama pricing",
    "ollama cost",
    "ollama tokens",
    "ollama credits",
    "ollama usage",
    "ollama pro",
    "ollama max",
    "copilot",
    "github-copilot",
    "copilot-chat",
    "byok",
    "token-tracker",
    "cost-tracker",
    "ai-credits",
    "token-usage",
    "llm-cost",
    "billing",
    "kimi",
    "deepseek",
    "qwen",
    "glm",
    "minimax",
    "gemma",
    "ai",
    "cost",
    "tokens",
    "dashboard"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "images/icon.png",
  "categories": [
    "AI",
    "Chat",
    "Visualization"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copilotCostOllama.openDashboard",
        "title": "Copilot Cost & Token Tracker - With Ollama Cloud Support: Open Dashboard"
      },
      {
        "command": "copilotCostOllama.resetUserId",
        "title": "Copilot Cost & Token Tracker - With Ollama Cloud Support: Reset Anonymous User ID"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "copilotCostOllama",
          "title": "Copilot Cost & Token Tracker - With Ollama Cloud Support",
          "icon": "images/activity-icon.svg"
        }
      ]
    },
    "views": {
      "copilotCostOllama": [
        {
          "id": "copilotCostOllamaPanel",
          "name": "Copilot Cost & Token Tracker - With Ollama Cloud Support"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "copilotCostOllamaPanel",
        "contents": "Click below to open the full Cost Dashboard.\n\n[$(zap) Open Dashboard](command:copilotCostOllama.openDashboard)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^3.0.0"
  }
}
